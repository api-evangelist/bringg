{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bringg Delivery Hub Administration API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://admin-api.bringg.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Administration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Companies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us2-admin-api.bringg.com/services/get_companies"
          },
          "docs": "Get merchants/companies the caller has access to."
        }
      ]
    }
  ],
  "bundled": true
}