{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bringg Delivery Hub Administration Order Configurations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://admin-api.bringg.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Order Configurations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Order Configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/create_task_configuration"
          },
          "docs": "Create a task configuration (set of driver actions and operational capabilities)."
        },
        {
          "info": {
            "name": "Update Order Configuration",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/update_task_configuration"
          },
          "docs": "Update an order configuration."
        }
      ]
    }
  ],
  "bundled": true
}