{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bringg Delivery Hub Administration Analytics API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://admin-api.bringg.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Analytics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Analytics Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us2-admin-api.bringg.com/services/analytics_reports"
          },
          "docs": "Retrieve an analytics report for a scheduled report."
        },
        {
          "info": {
            "name": "Get Report",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us2-admin-api.bringg.com/services/get_report"
          },
          "docs": "Get the latest version of a scheduled analytics report. Redirects to data file."
        }
      ]
    }
  ],
  "bundled": true
}