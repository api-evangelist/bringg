{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bringg Delivery Hub Administration Shifts API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://admin-api.bringg.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Shifts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Start Shift",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/start_shift"
          },
          "docs": "Start a driver's shift."
        },
        {
          "info": {
            "name": "End Shift",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/end_shift"
          },
          "docs": "End a driver's shift."
        }
      ]
    }
  ],
  "bundled": true
}