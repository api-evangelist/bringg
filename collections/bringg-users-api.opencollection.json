{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bringg Delivery Hub Administration Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://admin-api.bringg.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/create_user"
          },
          "docs": "Create a new user (driver, dispatcher, or other role)."
        },
        {
          "info": {
            "name": "Update User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/update_user"
          },
          "docs": "Update an existing user."
        },
        {
          "info": {
            "name": "Get User",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us2-admin-api.bringg.com/services/get_user"
          },
          "docs": "Get a user by id."
        },
        {
          "info": {
            "name": "Get Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us2-admin-api.bringg.com/services/get_users"
          },
          "docs": "List all users."
        },
        {
          "info": {
            "name": "Delete User",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://us2-admin-api.bringg.com/services/delete_user"
          },
          "docs": "Delete a user."
        },
        {
          "info": {
            "name": "Create User Role",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/create_user_type"
          },
          "docs": "Create a custom user role/type."
        }
      ]
    }
  ],
  "bundled": true
}