{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bringg Delivery Hub Administration Inventory API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://admin-api.bringg.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Inventory",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Inventory",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/create_inventory"
          },
          "docs": "Create an inventory item associated with an order."
        },
        {
          "info": {
            "name": "Update Inventory",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/update_inventory"
          },
          "docs": "Update an inventory item."
        }
      ]
    }
  ],
  "bundled": true
}