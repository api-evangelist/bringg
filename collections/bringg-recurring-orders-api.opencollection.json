{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bringg Delivery Hub Administration Recurring Orders API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://admin-api.bringg.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Recurring Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create Recurring Order Template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/create_recurrent_order_template"
          },
          "docs": "Create a recurring order template."
        },
        {
          "info": {
            "name": "Delete Recurring Order Template",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://us2-admin-api.bringg.com/services/delete_recurrent_order_template"
          },
          "docs": "Delete a recurring order template."
        },
        {
          "info": {
            "name": "Get Recurring Order Templates By Customer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us2-admin-api.bringg.com/services/get_recurrent_order_templates_by_customer"
          },
          "docs": "List recurring order templates for a customer."
        }
      ]
    }
  ],
  "bundled": true
}