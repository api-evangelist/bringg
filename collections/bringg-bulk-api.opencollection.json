{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bringg Delivery Hub Administration Bulk API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://admin-api.bringg.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Bulk",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Prepare Bulk Resource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/prepare_resource"
          },
          "docs": "Prepare a JSONL bulk upload resource (step 1 of bulk pipeline)."
        },
        {
          "info": {
            "name": "Process Bulk Resource",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://us2-admin-api.bringg.com/services/process_resource"
          },
          "docs": "Process the uploaded bulk resource (step 4 of bulk pipeline)."
        },
        {
          "info": {
            "name": "Get Bulk Resource Status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://us2-admin-api.bringg.com/services/get_process_resource"
          },
          "docs": "Get bulk processing status and results."
        }
      ]
    }
  ],
  "bundled": true
}